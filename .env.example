# =====================================================================
# .env.example — three-tier env structure
# Copy to .env (never committed). Fill in real values locally.
# =====================================================================

# ---------------------------------------------------------------------
# TIER 1 — Public / browser-safe
# Safe to expose in the client bundle. Use NEXT_PUBLIC_* (or framework
# equivalent). Never put secrets here.
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Your App Name"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------
# TIER 2 — Server-only
# Used by server-side code only. Never reaches the client bundle.
# If you ever consider adding NEXT_PUBLIC_ to one of these, STOP.
# ---------------------------------------------------------------------
DATABASE_URL=""
NEXTAUTH_SECRET=""

# ---------------------------------------------------------------------
# TIER 3 — Highly privileged
# Service-role keys, admin tokens, signing keys. Treat as radioactive.
# Compromise = rotate immediately. Never log. Never share in chat.
#
# If any TIER 3 variable ever receives a NEXT_PUBLIC_ prefix (or any
# other client-visible prefix), assume it has become compromised.
# Rotate the key and audit who could see the bundle since the change.
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
STRIPE_SECRET_KEY=""
